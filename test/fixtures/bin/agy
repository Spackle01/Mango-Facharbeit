#!/usr/bin/env node
// Test-Double der Antigravity CLI (Ereignisformat laut https://antigravity.google/docs/cli/headless/).
const args = process.argv.slice(2);
if (args[0] === '--version') { console.log('agy 1.2.3'); process.exit(0); }
if (args[0] === '--help') { console.log('-p, --print  --output-format text|json|stream-json  --conversation  --print-timeout  --model <slug>  --effort low|medium|high  --mode  Set the agent execution mode for this session (accept-edits, plan)'); process.exit(0); }
if (args[0] === 'models') {
  console.log('gemini-3.8-flash-high     Gemini 3.8 Flash (High)\ngemini-3.8-flash-medium   Gemini 3.8 Flash (Medium)\ngemini-3.1-pro-high       Gemini 3.1 Pro (High)');
  process.exit(0);
}
if (process.env.FAKE_AGY_LOG) require('fs').appendFileSync(process.env.FAKE_AGY_LOG, JSON.stringify({ args }) + '\n');
const model = args.includes('--model') ? args[args.indexOf('--model') + 1] : '';
const fmt = args[args.indexOf('--output-format') + 1];
const prompt = args[args.indexOf('-p') + 1];
const cid = args.includes('--conversation') ? args[args.indexOf('--conversation') + 1] : '055a398f-db14-4c5f-abbb-1bf03f8120a7';
if (process.env.FAKE_AGY_UNAUTH) { process.stderr.write('Error: authentication required\n'); process.exit(1); }
// Laut Doku: unbekanntes --model → Exit-Code 1, Grund auf stderr.
if (model && model === process.env.FAKE_AGY_REJECT) { process.stderr.write(`Error: invalid model "${model}"\n`); process.exit(1); }
if (fmt === 'json') {
  setTimeout(() => console.log(JSON.stringify({ conversation_id: cid, status: 'SUCCESS', response: 'OK' })), Number(process.env.FAKE_AGY_VERIFY_DELAY || 0));
  return;
}
const out = (o) => process.stdout.write(JSON.stringify(o) + '\n');
// Szenarien aus agy 1.3: Abbruch mit AGY_ERROR (Exit 3), verweigerte Aktionen, Text nur am Schrittende.
if (process.env.FAKE_AGY_FLAKY) {
  const fs = require('fs');
  const n = Number(fs.existsSync(process.env.FAKE_AGY_FLAKY) ? fs.readFileSync(process.env.FAKE_AGY_FLAKY, 'utf8') : 0) + 1;
  fs.writeFileSync(process.env.FAKE_AGY_FLAKY, String(n));
  if (n === 1) {
    out({ event: 'init', conversation_id: cid, init: { model: model || 'gemini-test' } });
    out({ event: 'step_update', step_update: { conversation_id: cid, step_index: 1, state: 'ACTIVE', step_type: 'agent_response', text_delta: 'Ich fange an' } });
    process.stderr.write('AGY_ERROR: {"short_error":"stream closed: connection reset by peer","status":"UNAVAILABLE","code":503,"retryable":true}\n');
    process.exit(3);
  }
}
if (process.env.FAKE_AGY_DENIED) {
  out({ event: 'init', conversation_id: cid, init: { model: model || 'gemini-test' } });
  out({ event: 'result', result: { conversation_id: cid, status: 'SUCCESS', response: '', denied_actions: [{ tool_name: 'write_to_file' }] } });
  process.exit(0);
}
if (process.env.FAKE_AGY_FULLTEXT) {
  out({ event: 'init', conversation_id: cid, init: { model: model || 'gemini-test' } });
  out({ event: 'step_update', step_update: { conversation_id: cid, step_index: 1, state: 'DONE', step_type: 'agent_response', text: 'Vollständige Antwort am Schrittende.' } });
  out({ event: 'result', result: { conversation_id: cid, status: 'SUCCESS', response: '' } });
  process.exit(0);
}
out({ event: 'init', conversation_id: cid, init: { cwd: process.cwd(), tools: ['read_file'], permission_mode: 'request-review', model: model || 'gemini-test' } });
out({ event: 'step_update', step_update: { conversation_id: cid, step_index: 1, state: 'ACTIVE', step_type: 'tool', tool_name: 'read_file', tool_info: { name: 'read_file', parameters: { AbsolutePath: `${process.cwd()}/00_vorgaben/anforderungen.md` } } } });
out({ event: 'step_update', step_update: { conversation_id: cid, step_index: 2, state: 'ACTIVE', step_type: 'agent_response', text_delta: 'Hallo ' } });
out({ event: 'step_update', step_update: { conversation_id: cid, step_index: 2, state: 'DONE', step_type: 'agent_response', text_delta: `von Antigravity (${prompt.length} Zeichen).` } });
out({ event: 'result', result: { conversation_id: cid, status: 'SUCCESS', response: 'Hallo von Antigravity.' } });
